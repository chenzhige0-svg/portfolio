---
import { work } from "../data/site";

const years = work.items.map((item) => Number(item.year));
const firstYear = Math.min(...years);
const lastYear = Math.max(...years);
const yearRange = firstYear === lastYear ? String(firstYear) : `${firstYear}–${lastYear}`;
---

<section class="section wrap" id="work" aria-labelledby="work-title">
  <header class="sec-head">
    <h2 id="work-title">{work.title}</h2>
    <p><span class="numeric">{yearRange} · {work.items.length}</span> 个项目</p>
  </header>

  <div class="work-list">
    {work.items.map((item) => (
      <details class="work-item" id={item.id}>
        <summary>
          <span class="work-item__meta">
            <time datetime={item.year}>{item.year}</time>
            <span>{item.tags.join(" / ")}</span>
          </span>
          <span class="work-item__heading">
            <span class="work-item__title" lang="en">{item.title}</span>
            <span class="work-item__sub">{item.subtitle}</span>
          </span>
          <span class="work-item__action" aria-hidden="true">
            <span class="work-item__expand">查看详情</span>
            <span class="work-item__collapse">收起详情</span>
            <span class="work-item__toggle"></span>
          </span>
        </summary>
        <div class="work-item__body">
          <p>{item.summary}</p>
          <dl class="results">
            {item.results.map(([value, label]) => (
              <div class="result">
                <dt>{value}</dt>
                <dd>{label}</dd>
              </div>
            ))}
          </dl>
          <p class="work-item__stack">{item.stack}</p>
        </div>
      </details>
    ))}
  </div>
</section>
