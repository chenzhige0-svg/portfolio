---
import { ticker } from "../data/site";

const group = [...ticker, ...ticker];
---

<div class="ticker" role="presentation">
  <div class="ticker__track">
    {[0, 1].map((copy) => (
      <div class="ticker__group" aria-hidden={copy === 1 ? "true" : undefined}>
        {group.map((item) => (
          <>
            <span class="ticker__item">{item}</span>
            <span class="ticker__sep" aria-hidden="true">✳</span>
          </>
        ))}
      </div>
    ))}
  </div>
</div>
