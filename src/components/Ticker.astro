---
import { keywords } from "../data/site";
---

<section class="ticker" aria-label="研究关键词" data-ticker>
  <div class="ticker__viewport">
    <div class="ticker__track">
      <ul class="ticker__group" role="list">
        {keywords.map((keyword) => <li>{keyword}</li>)}
      </ul>
      <ul class="ticker__group ticker__group--copy" aria-hidden="true" inert>
        {keywords.map((keyword) => <li>{keyword}</li>)}
      </ul>
    </div>
  </div>
  <button class="ticker__control" type="button">暂停滚动</button>
</section>

<script>
  const ticker = document.querySelector<HTMLElement>("[data-ticker]");
  const control = ticker?.querySelector<HTMLButtonElement>(".ticker__control");

  if (ticker && control) {
    ticker.setAttribute("data-motion-ready", "");
    control.addEventListener("click", () => {
      const paused = ticker.toggleAttribute("data-paused");
      control.textContent = paused ? "继续滚动" : "暂停滚动";
    });
  }
</script>
