---
import SectionHead from "./SectionHead.astro";
import { papers } from "../data/site";
---

<section class="section section--ink" id="papers" aria-labelledby="papers-title">
  <div class="wrap">
    <SectionHead title={papers.title} note={papers.note} id="papers-title" />
    <div class="paper-list">
      {papers.items.map((paper) => (
        <article class="paper">
          <time datetime={paper.year}>{paper.year}</time>
          <div>
            <h3 lang="en">{paper.originalTitle}</h3>
            <p class="paper__topic">{paper.topic}</p>
            <p class="paper__authors" lang="en">{paper.authors}</p>
          </div>
          <p class="paper__venue">
            <span lang="en">{paper.venue}</span>
            <span class="paper__kind">{paper.kind}</span>
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
