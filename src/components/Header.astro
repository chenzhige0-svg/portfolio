---
import { site } from "../data/site";
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="#top" aria-label={`${site.name}，回到首页`}>
      <span class="brand__mark" aria-hidden="true">{site.initials}</span>
      <span class="brand__name" lang={site.nameLang}>{site.name}</span>
    </a>
    <nav class="nav" aria-label="主导航">
      {site.nav.map((item, index) => (
        <>
          {index > 0 && <span class="nav__separator" aria-hidden="true">/</span>}
          <a href={item.href}>{item.label}</a>
        </>
      ))}
    </nav>
    <details class="directory">
      <summary>目录 <span class="directory__toggle" aria-hidden="true"></span></summary>
      <nav aria-label="页面目录">
        {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>
