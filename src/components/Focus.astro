---
import SectionHead from "./SectionHead.astro";
import { focus } from "../data/site";
---

<section class="focus section" id="focus" aria-labelledby="focus-title">
  <div class="wrap">
    <SectionHead title={focus.title} id="focus-title" />
    <div class="focus-grid">
      {focus.items.map((item) => (
        <article class="focus-item">
          <h3>{item.title}</h3>
          <p class="focus-item__question">{item.question}</p>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
