---
import { contact, site } from "../data/site";

const Email = contact.email.href ? "a" : "p";
---

<footer class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="contact__main">
      <h2 class="contact__title" id="contact-title" aria-label={contact.title.join("与")}>
        {contact.title.map((line) => <span aria-hidden="true">{line}</span>)}
      </h2>
      <div class="contact__details">
        <p class="contact__lead">{contact.lead}</p>
        <p class="contact__email-label">{contact.email.label}</p>
        <Email class="contact__mail" href={contact.email.href}>
          <span class="email-address">{contact.email.address}</span>
          {contact.email.href && <span aria-hidden="true">↗</span>}
        </Email>
        {contact.links.length > 0 && (
          <nav class="contact__links" aria-label="更多联系入口">
            {contact.links.map((link) => (
              <a href={link.href}>
                {link.label}<span aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>
        )}
      </div>
    </div>
    <div class="footer">
      <p>{contact.copyright} <span>{site.sampleNote}</span></p>
      <a href="#top">返回顶部 <span class="footer__arrow" aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>
