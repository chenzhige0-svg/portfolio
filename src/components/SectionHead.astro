---
interface Props {
  index: string;
  title: string;
  note?: string;
  id?: string;
}

const { index, title, note, id } = Astro.props;
---

<header class="sec-head reveal">
  <span class="sec-head__index" aria-hidden="true">{index}</span>
  <h2 class="sec-head__title" id={id}>{title}</h2>
  {note && <p class="sec-head__note">{note}</p>}
</header>
