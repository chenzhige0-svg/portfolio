---
import { contact, focus, site } from "../data/site";

const [firstName, ...remainingNames] = site.name.trim().split(/\s+/);
const secondLine = remainingNames.join(" ");
const Email = contact.email.href ? "a" : "p";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__grid">
    <div class="hero__intro">
      <p class="hero__sample">{site.sampleLabel}</p>
      <div class="hero__identity">
        <h1 id="hero-title" class="hero__name" lang={site.nameLang} aria-label={site.name}>
          <span class="hero__title-line" aria-hidden="true">{firstName}</span>
          {secondLine && <span class="hero__title-line" aria-hidden="true">{secondLine}</span>}
        </h1>
        {site.nameLang === "zh-CN" && <p class="hero__latin" lang="en">{site.latinName}</p>}
      </div>
      <div class="hero__foot">
        <p class="hero__lead">{site.lead}</p>
        <a class="button button--primary" href="#work">查看项目 <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="hero__panel">
      <p class="hero__role">{site.role}</p>
      <div class="hero__panel-details">
        <a class="hero__research-link" href="#focus">
          <span>{focus.title}</span>
          <span class="hero__topics">{focus.items.map((item) => item.title).join(" · ")}</span>
          <span class="hero__research-arrow" aria-hidden="true">↗</span>
        </a>
        <Email class="hero__email" href={contact.email.href}>
          <span>{contact.email.label}</span>
          <span class="email-address">{contact.email.address}</span>
        </Email>
      </div>
    </div>
  </div>
</section>
