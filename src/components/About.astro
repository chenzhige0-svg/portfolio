---
import SectionHead from "./SectionHead.astro";
import { about, site } from "../data/site";
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <SectionHead title={about.title} note={site.location} id="about-title" />
    <div class="about-grid">
      <div class="about-bio">
        {about.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <ol class="timeline" aria-label="研究经历">
        {about.timeline.map((entry) => (
          <li class="timeline__row">
            <span class="timeline__period">{entry.period}</span>
            <div>
              <h3>{entry.role}</h3>
              <p>{entry.org}</p>
              <p class="timeline__note">{entry.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <dl class="stats">
      {about.stats.map((stat) => (
        <div class="stat">
          <dt>{stat.value}</dt>
          <dd>{stat.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
