---
import SectionHead from "./SectionHead.astro";
import { about } from "../data/site";
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <SectionHead index={about.index} title={about.title} note={about.note} id="about-title" />

    <div class="about-grid">
      <div class="about-bio reveal">
        {about.bio.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <div class="timeline reveal" style="--delay:120ms">
        {about.timeline.map((entry) => (
          <div class="timeline__row">
            <span class="timeline__period">{entry.period}</span>
            <div>
              <p class="timeline__role">{entry.role}</p>
              <p class="timeline__org">{entry.org}</p>
              <p class="timeline__note">{entry.note}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="stats reveal">
      {about.stats.map((stat) => (
        <div class="stat">
          <p class="stat__value">{stat.value}</p>
          <p class="stat__label">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
